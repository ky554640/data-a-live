+#if defined(SWEET)
+/*
+ * 0349: `sweethid_off=1` keeps the HID services out of the event system
+ * entirely, so backboardd's startHIDSystem has nothing to add and cannot enter
+ * the session-schedule wait.  Diagnostics only: no touch, no keys.
+ */
+static int
+sweet_hid_publish_off(void)
+{
+	int off = 0;
+
+	(void)PE_parse_boot_argn("sweethid_off", &off, sizeof(off));
+	return off != 0;
+}
+#endif
