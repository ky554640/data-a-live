+#if defined(SWEET)
+/*
+ * 0344: the service from 0343 was published but never opened.  Give it a user
+ * client, log who opens it and which selectors it asks for, and answer
+ * success to everything so a client that only wants to connect can proceed.
+ * (No proc_t here: sys/proc.h does not expose it to this C++ unit.)
+ */
+class IOHIDEventSystemUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOHIDEventSystemUserClient);
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOHIDEventSystemUserClient, IOUserClient);
+
+bool
+IOHIDEventSystemUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	IOLog("SWEET HID: IOHIDEventSystem open by task %p type %#x\n", owningTask, type);
+	return true;
+}
+
+IOReturn
+IOHIDEventSystemUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	static uint8_t logs[256];
+	if (selector < 256 && logs[selector]++ < 4) {
+		IOLog("SWEET HID: IOHIDEventSystem sel %u in %u/%u out %u/%u\n", selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif
+
 OSDefineMetaClassAndStructors(IOHIDEventSystem, IOService);
 
 bool
@@ -71,6 +113,7 @@ IOHIDEventSystem::start(IOService *provider)
 	if (!IOService::start(provider)) {
 		return false;
 	}
+	setProperty("IOUserClientClass", "IOHIDEventSystemUserClient");
 	registerService();
 	IOLog("SWEET HID: IOHIDEventSystem published\n");
 	return true;
