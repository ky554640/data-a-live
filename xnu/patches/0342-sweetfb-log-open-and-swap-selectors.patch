+/* 0342: who is driving the framebuffer?  The iOS side is silent about it. */
+static int
+sweet_fb_client_pid(task_t t)
+{
+	proc_t p = (t != NULL) ? (proc_t)get_bsdtask_info(t) : NULL;
+	return (p != NULL) ? proc_pid(p) : -1;
+}
+
+static const char *
+sweet_fb_client_comm(task_t t)
+{
+	static char name[64];
+	proc_t p = (t != NULL) ? (proc_t)get_bsdtask_info(t) : NULL;
+	if (p == NULL) {
+		return "?";
+	}
+	name[0] = 0;
+	proc_name(proc_pid(p), name, sizeof(name));
+	return name;
+}
