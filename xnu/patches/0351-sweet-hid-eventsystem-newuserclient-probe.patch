+IOReturn
+IOHIDEventSystem::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	IOReturn ret;
+
+	IOLog("SWEET HID: IOHIDEventSystem newUserClient type %#x props %p ucc %s\n",
+	    type, properties, getProperty("IOUserClientClass") ? "set" : "missing");
+	ret = super::newUserClient(owningTask, securityID, type, properties, handler);
+	IOLog("SWEET HID: IOHIDEventSystem newUserClient -> %#x handler %p\n",
+	    ret, handler ? *handler : NULL);
+	if (ret != kIOReturnSuccess && handler != NULL) {
+		IOHIDEventSystemUserClient *client = OSTypeAlloc(IOHIDEventSystemUserClient);
+		if (client != NULL && client->initWithTask(owningTask, securityID, type) &&
+		    client->attach(this) && client->start(this)) {
+			*handler = client;
+			IOLog("SWEET HID: IOHIDEventSystem fallback client ok\n");
+			return kIOReturnSuccess;
+		}
+		if (client != NULL) {
+			client->release();
+		}
+		IOLog("SWEET HID: IOHIDEventSystem fallback client failed\n");
+	}
+	return ret;
+}
