 			cs_procs_invalidated++;
@@ -304,6 +313,7 @@ cs_invalid_page(addr64_t vaddr, boolean_t *cs_killed)
 		} else {
 			proc_csflags_update(p, flags);
 		}
+#endif
 	}
 	proc_unlock(p);
 
