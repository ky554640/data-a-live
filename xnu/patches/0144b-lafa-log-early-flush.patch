@@ -51,6 +51,7 @@ extern int hz;
 static void sweet_log_start(void);
 #if defined(PANDORA)
 static void pandora_log_start(void);
+static void pandora_log_early(void);
 static void pf_load_extents(void);
 #endif
 extern void sweet_sample_start(void);
@@ -1598,6 +1599,11 @@ sweet_ufs_init(void)
 		}
 	}
 	if (!fx_root) rw=0;
+#endif
+#if defined(PANDORA)
+	/* Allow the log file and prepare it before the mount path can fail. */
+	su.writable = (rw != 0);
+	pandora_log_early();
 #endif
 	lck_mtx_unlock(&sweet_ufs_lock);
 	if (error) {
@@ -2091,6 +2097,26 @@ pandora_log_start(void)
 		thread_deallocate(thread);
 	}
 }
+
+/*
+ * Called from sweet_ufs_init as soon as the extent tables are loaded and the
+ * partition bounds are known (su.writable already set): hook the reset path
+ * and flush the ring once, so a panic anywhere in the rest of the mount path
+ * still writes the console log to the pinned file.
+ */
+static void
+pandora_log_early(void)
+{
+	PE_halt_restart = pandora_halt_restart;
+	if (pl_next == 0 || !su.writable) {
+		return;
+	}
+	pl_ready = true;
+	lck_mtx_lock(&sweet_ufs_lock);
+	(void)pl_flush();
+	lck_mtx_unlock(&sweet_ufs_lock);
+	printf("PANDORA LOG: early flush (%u extents, %llu bytes)\n", pl_next, pl_flushed);
+}
 #endif /* PANDORA */
 
 
