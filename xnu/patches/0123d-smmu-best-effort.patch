+		PE_parse_boot_argn("ufssmmu", &mode, sizeof(mode));
+		printf("PANDORA UFS: no free bank (slot %d bank %d ufs %d free %d sCR0=%08x mode %u)\n",
+		    slot, bank, ufsSlot, freeSMR, scr0, mode);
+		if (mode == 2) {
 			s[0] = scr0 | 1U;
 			__asm__ volatile ("dsb sy" ::: "memory");
-			if (!(s[0] & 1U)) {
-				printf("PANDORA UFS: SMMU global bypass readback\n");
-				return EIO;
-			}
-			printf("PANDORA UFS: SMMU global CLIENTPD bypass (sCR0=%08x)\n", s[0]);
+			printf("PANDORA UFS: SMMU global CLIENTPD sCR0 %08x->%08x\n", scr0, s[0]);
+			return 0;
+		}
+		if (mode == 0 || use < 0) {
+			printf("PANDORA UFS: SMMU left as-is (mode %u)\n", mode);
+			return 0;
+		}
+		uint32_t s2cr0 = s[(0xc00 + 4 * use) / 4];
+		uint32_t smr0 = s[(0x800 + 4 * use) / 4];
+		if (mode == 3) {
+			unsigned cb = (s2cr0 & 255) < banks ? (s2cr0 & 255) : 0;
+			unsigned cbreg = (pages + cb) * 4096;
+			uint32_t sctlr0 = s[cbreg / 4];
+			s[cbreg / 4] = sctlr0 & ~1U;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			printf("PANDORA UFS: SMMU bank %u SCTLR %08x->%08x (S2CR %08x)\n",
